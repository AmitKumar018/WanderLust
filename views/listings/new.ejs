<% layout("/layouts/boilerplate") %>

<section class="form-page">
  <div class="form-heading">
    <p class="eyebrow">Become a host</p>
    <h1>Create a listing</h1>
  </div>

  <form method="POST" action="/listings" class="needs-validation listing-form" novalidate enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-section">
      <h2>Basics</h2>
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input id="title" type="text" name="listing[title]" placeholder="Cozy hilltop villa with valley views" class="form-control" required maxlength="120">
        <div class="invalid-feedback">Please add a title.</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea id="description" name="listing[description]" rows="5" placeholder="Tell guests what makes this place special." class="form-control" required maxlength="2000"></textarea>
        <div class="invalid-feedback">Please add a description.</div>
      </div>

      <div class="mb-3">
        <label for="images" class="form-label">Photos</label>
        <input id="images" name="listing[images]" type="file" class="form-control" accept="image/png,image/jpeg,image/webp" multiple required>
        <div class="form-text">Upload up to 6 photos. The first photo becomes the cover.</div>
      </div>
    </div>

    <div class="form-section">
      <h2>Details</h2>
      <div class="row g-3">
        <div class="col-md-6">
          <label for="price" class="form-label">Nightly price</label>
          <input id="price" name="listing[price]" type="number" min="0" class="form-control" required>
          <div class="invalid-feedback">Please enter a valid price.</div>
        </div>
        <div class="col-md-3">
          <label for="bedrooms" class="form-label">Bedrooms</label>
          <input id="bedrooms" name="listing[bedrooms]" type="number" min="0" max="30" value="1" class="form-control" required>
        </div>
        <div class="col-md-3">
          <label for="bathrooms" class="form-label">Baths</label>
          <input id="bathrooms" name="listing[bathrooms]" type="number" min="0" max="30" value="1" class="form-control" required>
        </div>
      </div>
    </div>

    <div class="form-section">
      <h2>Location and style</h2>
      <div class="row g-3">
        <div class="col-md-7">
          <label for="location" class="form-label">Location</label>
          <input id="location" name="listing[location]" type="text" class="form-control" required>
        </div>
        <div class="col-md-5">
          <label for="country" class="form-label">Country</label>
          <input id="country" name="listing[country]" type="text" class="form-control" required>
        </div>
        <div class="col-md-6">
          <label for="category" class="form-label">Category</label>
          <select id="category" name="listing[category]" class="form-select" required>
            <% categories.forEach((category) => { %>
              <option value="<%= category.value %>"><%= category.label %></option>
            <% }) %>
          </select>
        </div>
      </div>
    </div>

    <div class="form-section">
      <h2>Amenities and rules</h2>
      <div class="amenity-grid">
        <% amenities.forEach((amenity) => { %>
          <label class="form-check amenity-check">
            <input class="form-check-input" type="checkbox" name="listing[amenities]" value="<%= amenity %>">
            <span><%= amenity %></span>
          </label>
        <% }) %>
      </div>
      <div class="mt-3">
        <label for="houseRules" class="form-label">House rules</label>
        <textarea id="houseRules" name="listing[houseRules]" rows="3" class="form-control" maxlength="1200" placeholder="Respect the home and the neighborhood."></textarea>
      </div>
    </div>

    <button class="btn btn-brand btn-lg" type="submit">Create listing</button>
  </form>
</section>
